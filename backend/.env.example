APP_NAME=MechMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Configuration
FIREBASE_PROJECT_ID=mechmate-prod
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
FIREBASE_DATABASE_URL=https://mechmate-prod.firebaseio.com
FIREBASE_STORAGE_BUCKET=mechmate-prod.appspot.com

# Session and Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration (For Password Reset)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@mechmate.com"
MAIL_FROM_NAME="${APP_NAME}"
